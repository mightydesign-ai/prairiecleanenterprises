# Postgres connection string. On Vercel, the Neon integration sets DATABASE_URL for you.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Random string used to hash visitor IPs for form rate limiting. openssl rand -hex 16
IP_HASH_SALT=
# Public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave unset until launch. Only "true" lets search engines and AI crawlers index the site.
SITE_INDEXABLE=
# Vercel Blob token for uploads. Leave empty locally to store uploads on disk.
BLOB_READ_WRITE_TOKEN=
# Used once by `pnpm seed` to create the first admin account
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
