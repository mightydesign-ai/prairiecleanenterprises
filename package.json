{
  "name": "prairiecleanenterprises",
  "version": "0.1.0",
  "private": true,
  "description": "Prairie Clean Enterprises website: Next.js 15, Payload CMS 3, Tailwind CSS 4, Postgres (Neon), Vercel",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "ci": "pnpm check:svg && payload migrate && pnpm build",
    "typecheck": "tsc --noEmit",
    "check:svg": "node scripts/check-svg.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "import-images": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/import-images.ts",
    "upload-blob": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/upload-to-blob.ts",
    "reset-images": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/reset-images.ts",
    "optimize-media": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/optimize-media.ts",
    "import-heroes": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/import-heroes.ts",
    "attach-heroes": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/attach-heroes.ts",
    "images:rebuild": "npm run reset-images && npm run import-images && npm run upload-blob",
    "attach-media": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/attach-media.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-vercel-blob": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@vercel/blob": "2.3.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.92.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": ">=3.4.17",
      "happy-dom": ">=21.0.4"
    }
  }
}
